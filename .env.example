# QISM 1 §18 — barchasi majburiy, biri yetishmasa dastur ishga tushmaydi.
# Nusxa oling:  cp .env.example .env

# docker-compose.yml dagi `baza` xizmatiga mos keladi
DATABASE_URL=postgres://jalyuzi:jalyuzi@localhost:5432/jalyuzi

# Kamida 32 belgi. Yangisini yasash:  openssl rand -base64 32
AUTH_SECRET=loqal_ishlab_chiqish_uchun_kalit_32_belgidan_uzun

# Bot 7-bosqichda ulanadi. Shu paytgacha shu qiymatlar joyida qoladi —
# tizim ishlaydi, faqat bot xabar yubormaydi.
TELEGRAM_BOT_TOKEN=loqal-bot-tokeni-hali-ulanmagan
TELEGRAM_ADMIN_CHAT_ID=0
BACKUP_CHANNEL_ID=0

# /api/cron/* yo'llarini himoyalaydi (§13)
CRON_SECRET=loqal_cron_kaliti_16_dan_uzun

TZ=Asia/Tashkent
