{
  "name": "jalyuzi-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "hammasi": "tsx ishga-tushir.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:kuzat": "vitest",
    "test:qamrov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:urug": "tsx --env-file=.env lib/db/urug-ishga.ts",
    "db:tozala": "tsx --env-file=.env lib/db/tozala-buyruq.ts",
    "test:baza": "vitest run --config vitest.baza.config.ts",
    "test:hammasi": "npm run test && npm run test:baza",
    "bot": "tsx --env-file=.env bot/ishga-tushir.ts",
    "db:ruxsat": "tsx --env-file=.env lib/db/ruxsat-buyruq.ts",
    "db:sinov-tozala": "tsx --env-file=.env lib/db/sinov-tozala.ts",
    "db:xato": "tsx --env-file=.env lib/db/xato-buyruq.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.5",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "telegraf": "^4.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
